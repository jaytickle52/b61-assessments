# --- Vercel (Next.js app) ---
NEXT_PUBLIC_CONVEX_URL=        # from `npx convex dev`
APP_URL=https://reportcard.banner61.com
WORKER_SECRET=                 # long random string; set the same value in Convex env
CTA_URL=                       # booking link for "Schedule a call" (e.g. a GHL calendar link)

ANTHROPIC_API_KEY=
GRADER_MODEL=claude-sonnet-5-5 # model for the AI-assisted items
PAGESPEED_API_KEY=             # Google Cloud key with the PageSpeed Insights API enabled (free)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

RESEND_API_KEY=
EMAIL_MODE=off                 # off | test | live. Keep off or test until the email copy is approved.
TEST_EMAIL=jay@banner61.com    # where test-mode emails go
REPORT_FROM=Jay Tickle <jay@banner61.com>
REPORT_REPLY_TO=jay@banner61.com

GHL_API_KEY=                   # private integration token; leave empty to skip GHL
GHL_LOCATION_ID=
GHL_PIPELINE_ID=               # optional: opens an opportunity per request
GHL_PIPELINE_STAGE_ID=
GHL_FIELD_REPORT_LINK=         # optional custom field keys, e.g. contact.report_card_link
GHL_FIELD_REPORT_SCORE=
GHL_FIELD_WEBSITE_MANAGER=

# --- Convex environment (npx convex env set ...) ---
# APP_URL, WORKER_SECRET
